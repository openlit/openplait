{
  "name": "@openplait/core",
  "version": "1.0.0",
  "description": "Portable OpenPlait resource types, schemas, validation, and serialization.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/src",
    "dist/schemas",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schemas/v1alpha1/*": "./dist/schemas/v1alpha1/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "license": "Apache-2.0",
  "author": "OpenLIT",
  "homepage": "https://github.com/openlit/openplait#readme",
  "bugs": {
    "url": "https://github.com/openlit/openplait/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openlit/openplait.git",
    "directory": "typescript/packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "openplait",
    "openlit",
    "opentelemetry",
    "observability",
    "datasource",
    "adapter",
    "promql",
    "traceql",
    "logql",
    "core"
  ]
}
