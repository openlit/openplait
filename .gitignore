# OpenPlait — https://github.com/openlit/openplait
# Clone: git clone git@github.com:openlit/openplait.git

# Dependencies
node_modules/
**/node_modules/

# Build / export outputs
.next/
out/
dist/
coverage/
docs/.next/
docs/out/
typescript/**/dist/
*.tsbuildinfo

# Env & secrets
.env
.env.*
!.env.example

# Logs & OS
*.log
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
python/.venv/
python/dist/
python/*.egg-info/
python/**/*.egg-info/
# Local poetry config overrides (keep poetry.lock tracked)
python/poetry.toml

# Editor / tooling
.idea/
*.swp
*.swo
